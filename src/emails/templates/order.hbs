<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width">
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <title>PGM Outfitters - Order</title>
        <style>
            table {
                background: #ebebeb;
                padding: 0;
                margin: 0;
            }
            tr {
                margin: 0;
                padding: 0;
                border: none;
            }
            th,td {
                padding: 10px;
                border: 0;
            }
        </style>
    </head>
    <body style="color: black;">
        <header>
            <h1>{{heading}}</h1>
            <p>Order {{orderId}}</p>
        </header>
        <div>
            <h3>Order summary</h3>
            <table width="300px" cellspacing="0">
                <thead>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Price</th>
                </thead>
                {{#each items}}
                    <tr>
                        <td><a href="{{link}}" target="_blank">{{name}}</a></td>
                        <td style="text-align: center;">{{qty}}</td>
                        <td style="text-align: right;">{{price}}</td>
                    </tr>
                {{/each}}
                <tr style="background: #223047; color: white;">
                    <td colspan="2" style="text-align: right; font-weight: bold;">
                        Total
                    </td>
                    <td style="text-align: center; font-weight: bold; background: #7C8969; color: white;">
                        {{total}}
                    </td>
                </tr>
            </table>
            <h3>Pickup</h3>
            <p>
                Pickup at {{pickupAddress}}.<br />
                Please call ahead at {{pickupPhone}} to schedule pickup.
            </p>
            <h3>Contact</h3>
            <div>
                {{customerName}}
                <br />
                {{customerEmail}}
                <br />
                {{customerPhone}}
            </div>
        </div>
    </body>
</html>
